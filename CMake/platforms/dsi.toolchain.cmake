set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR armv5te)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(NINTENDO_DSI ON CACHE BOOL "Nintendo DSi target")
set(DEVKITPRO "$ENV{DEVKITPRO}" CACHE PATH "devkitPro root")
set(DEVKITARM "${DEVKITPRO}/devkitARM")
set(CMAKE_C_COMPILER "${DEVKITARM}/bin/arm-none-eabi-gcc.exe")
set(CMAKE_CXX_COMPILER "${DEVKITARM}/bin/arm-none-eabi-g++.exe")
set(CMAKE_AR "${DEVKITARM}/bin/arm-none-eabi-ar.exe")
set(CMAKE_RANLIB "${DEVKITARM}/bin/arm-none-eabi-ranlib.exe")
set(CMAKE_STRIP "${DEVKITARM}/bin/arm-none-eabi-strip.exe")
set(_dsi_flags "-march=armv5te -mtune=arm946e-s -mthumb -DARM9 -D__NDS__ -I${DEVKITPRO}/libnds/include -I${DEVKITPRO}/calico/include -ffunction-sections -fdata-sections")
set(CMAKE_C_FLAGS_INIT "${_dsi_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_dsi_flags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-specs=${DEVKITPRO}/calico/share/ds9.specs -L${DEVKITPRO}/calico/lib -L${DEVKITPRO}/libnds/lib -Wl,--gc-sections")
set(CMAKE_FIND_ROOT_PATH "${DEVKITARM}/arm-none-eabi;${DEVKITPRO}/libnds;${DEVKITPRO}/calico")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
